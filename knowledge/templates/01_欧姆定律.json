{
  "name": "欧姆定律",
  "difficulty": "easy",
  "keywords": ["欧姆定律", "电阻", "串联", "并联", "分压", "分流", "等效电阻"],
  "description": "利用欧姆定律 v=Ri 及电阻串并联关系求解基本电路",
  "method": "欧姆定律",
  "steps": [
    "确定各元件的参考方向（关联或非关联）",
    "识别电阻的串联/并联关系，计算等效电阻",
    "应用欧姆定律 v = Ri 列方程",
    "求解未知量",
    "验证功率守恒"
  ],
  "formulas": [
    "v = Ri（关联参考方向）",
    "串联：R_eq = R₁ + R₂ + ... + Rₙ",
    "并联：1/R_eq = 1/R₁ + 1/R₂ + ... + 1/Rₙ",
    "两电阻并联：R_eq = R₁R₂/(R₁+R₂)",
    "分压公式：v₁ = v·R₁/(R₁+R₂)",
    "分流公式：i₁ = i·R₂/(R₁+R₂)",
    "功率：p = i²R = v²/R = vi"
  ],
  "pitfalls": [
    "必须先确定参考方向再列方程",
    "分压/分流公式的分子分母不要搞混",
    "并联电阻的等效值总是小于最小的单个电阻",
    "注意区分关联和非关联参考方向下的功率正负"
  ]
}
